{
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always"
	},
	"editor.formatOnSave": false,
	"editor.hover.enabled": "on",
	"editor.insertSpaces": true,
	"editor.tabSize": 2,
	"files.exclude": {
		"**/node_modules": true,
		"**/.pnpm-store": true
		//"**/dist": true,
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/.pnpm-store": true
	}
}
