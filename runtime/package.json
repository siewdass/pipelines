{
  "name": "runtime",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --outfile=dist/runtime.js --define:process.env.NODE_ENV='\"production\"' --define:import.meta.env=\"{}\" --loader:.css=text",
    "build:dev": "esbuild src/index.ts --bundle --outfile=dist/runtime.js --define:process.env.NODE_ENV='\"development\"' --define:import.meta.env=\"{}\" --loader:.css=text",
    "type-check": "tsc --noEmit",
    "build:watch": "esbuild src/index.ts --bundle --outfile=dist/runtime.js --define:process.env.NODE_ENV='\"development\"' --define:import.meta.env=\"{}\" --loader:.css=text --watch",
    "serve": "tsx src/server.ts",
    "dev": "concurrently -n esbuild,express \"pnpm build:watch\" \"pnpm serve\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jsonforms/core": "^3.7.0",
    "@jsonforms/react": "^3.7.0",
    "@jsonforms/vanilla-renderers": "^3.7.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "react": "^19.2.4",
    "react-accessible-accordion": "^5.0.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-icons": "^5.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-responsive-modal": "^7.1.0",
    "react-router": "^7.13.1",
    "react-select": "^5.10.2",
    "react-tabs": "^6.1.0",
    "react-tooltip": "^5.30.0",
    "react-use": "^17.6.0",
    "recharts": "^3.8.1",
    "socketcluster-client": "^20.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
